#define MAX_LIGHT_COUNT 2048
#define LOCAL_SIZE 8

#extension GL_QCOM_tile_shading : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// vkCmdDispatchTileQCOM fires one workgroup per tile on this device regardless of local_size.
// Only workgroup (0,0) does real work (guard below); all others exit immediately.
// Within that workgroup, LOCAL_SIZE*LOCAL_SIZE threads parallelize the AABB reduction via
// subgroupMin/Max, identical per-cluster computation to LightCullingTileShading.comp.
// Clusters within the tile are processed serially since the driver provides only one
// workgroup per tile dispatch.
//
// NOTE: alternative parallel design for spec-compliant implementations:
// The Vulkan spec states that vkCmdDispatchTileQCOM with shading_rate_xQCOM=R fires
// ceil(tile_w/R) * ceil(tile_h/R) invocations per tile, with gl_GlobalInvocationID
// tile-local (resets to 0 for each tile).  On an implementation that honours this,
// each cluster can be assigned its own invocation using a stride-based guard:
//
#if 0
layout(shading_rate_xQCOM = LOCAL_SIZE, shading_rate_yQCOM = LOCAL_SIZE, shading_rate_zQCOM = 1) in;
// stride = clusterSize / LOCAL_SIZE  (e.g. 96/8 = 12 invocations per cluster dim)
// In main():
//   uvec2 stride       = clusterSize / uvec2(LOCAL_SIZE);
//   uvec2 currentInvoc = gl_GlobalInvocationID.xy;          // tile-local per spec
//   if (any(notEqual(currentInvoc % stride, uvec2(0)))) return;
//   uvec2 clusterKey   = gl_TileOffsetQCOM.xy / clusterSize + currentInvoc / stride;
// This dispatches one invocation per cluster across all tiles in parallel,
// replacing the serial cx/cy loop below with a single independent invocation.
#endif
layout(local_size_x = LOCAL_SIZE, local_size_y = LOCAL_SIZE, local_size_z = 1) in;

struct LightUB
{
    vec4 lightPosAndRadius; // xyz = pos | w = radius
    vec4 lightColor;
};

struct SceneInfoUB
{
    mat4 projectionInv;
    mat4 view;
    mat4 viewInv;
    mat4 viewProjection;
    mat4 viewProjectionInv; // ViewInv * ProjectionInv
    vec4 projectionInvW;    // w components of ProjectionInv
    vec4 cameraPos;

    vec4 skyLightDirection;
    vec4 skyLightColor;

    vec4 ambientColor;

    uint viewportWidth;
    uint viewportHeight;
    uint binCountX;
    uint binCountY;
    uint globalClusterCountX;
    uint globalClusterCountY;
    uint binClusterCountX;
    uint binClusterCountY;
    uint clusterSizeX;
    uint clusterSizeY;
    int lightCount;
    int debugShaders;
    int ignoreLightTiles;
    int tileMemoryEnabled;
    int padding1;
    int padding2;
};

layout(set = 0, binding = 0, tile_attachmentQCOM, r32f) uniform highp readonly image2D u_DepthTex;

layout(std140, set = 0, binding = 1) uniform SceneInfo
{
    SceneInfoUB sceneInfo;
};

layout(std140, set = 0, binding = 2) uniform Lights
{
    LightUB lights[MAX_LIGHT_COUNT];
};

layout(std430, set = 0, binding = 3) buffer writeonly TileLightIndices
{
    uint lightIndices[];
};

layout(std430, set = 0, binding = 4) buffer writeonly TileLightCounts
{
    uint lightCounts[];
};


vec3 reconstructWorldPosition(highp vec2 uv, highp float depth)
{
    highp vec4 clipSpacePos = vec4(
        uv.x * 2.0 - 1.0,
        (1.0 - uv.y) * 2.0 - 1.0,
        depth,
        1.0
    );

    highp vec4 fragViewSpacePos = sceneInfo.projectionInv * clipSpacePos;
    fragViewSpacePos /= fragViewSpacePos.w;
    return (sceneInfo.viewInv * fragViewSpacePos).xyz;
}

void main()
{
    // Only workgroup (0,0) per tile processes clusters; all others exit immediately.
    // Cluster indexing is derived from gl_TileOffsetQCOM so it is safe regardless of
    // how many workgroups vkCmdDispatchTileQCOM fires per tile on this device.
    if (gl_WorkGroupID.x != 0u || gl_WorkGroupID.y != 0u)
        return;

    uvec2 clusterSize    = uvec2(sceneInfo.clusterSizeX, sceneInfo.clusterSizeY);
    uvec2 tileOffset     = gl_TileOffsetQCOM.xy;
    uvec2 baseClusterKey = tileOffset / clusterSize;

    // Serially process every cluster in this tile.
    // Within each cluster, all LOCAL_SIZE*LOCAL_SIZE threads work in parallel.
    for (uint cy = 0u; cy < sceneInfo.binClusterCountY; ++cy)
    {
        for (uint cx = 0u; cx < sceneInfo.binClusterCountX; ++cx)
        {
            uvec2 clusterKey   = baseClusterKey + uvec2(cx, cy);
            uint  clusterIndex = clusterKey.y * sceneInfo.globalClusterCountX + clusterKey.x;

            uint clusterMinX = clusterKey.x * clusterSize.x;
            uint clusterMinY = clusterKey.y * clusterSize.y;

            if (clusterMinX >= sceneInfo.viewportWidth || clusterMinY >= sceneInfo.viewportHeight)
            {
                if (gl_LocalInvocationID.x == 0u && gl_LocalInvocationID.y == 0u)
                    lightCounts[clusterIndex] = 0u;
                continue;
            }

            // Each thread covers a (clusterSize/LOCAL_SIZE)^2 block of pixels,
            // identical layout to LightCullingTileShading.comp.
            highp vec3 clusterMin = vec3( 1e8);
            highp vec3 clusterMax = vec3(-1e8);

            for (uint y = 0u; y < clusterSize.y / LOCAL_SIZE; ++y)
            {
                for (uint x = 0u; x < clusterSize.x / LOCAL_SIZE; ++x)
                {
                    ivec2 pixelLocation = ivec2(ivec2(clusterMinX, clusterMinY) +
                                                ivec2(clusterSize / LOCAL_SIZE) * gl_LocalInvocationID.xy) +
                                          ivec2(x, y);

                    vec2 uv = vec2(float(pixelLocation.x) / float(sceneInfo.viewportWidth),
                                   float(pixelLocation.y) / float(sceneInfo.viewportHeight));
                    if (uv.x > 1.0 || uv.y > 1.0)
                        continue;

                    highp float depth = imageLoad(u_DepthTex, pixelLocation).r * 2.0 - 1.0;
                    vec3 worldPos = reconstructWorldPosition(uv, depth);

                    clusterMin = min(clusterMin, worldPos);
                    clusterMax = max(clusterMax, worldPos);
                }
            }

            clusterMax = subgroupMax(clusterMax);
            clusterMin = subgroupMin(clusterMin);

            if (gl_LocalInvocationID.x == 0u && gl_LocalInvocationID.y == 0u)
            {
                uint tileLightCount = 0u;
                for (int lightId = 0; lightId < int(sceneInfo.lightCount); ++lightId)
                {
                    vec3  lightPos    = lights[lightId].lightPosAndRadius.xyz;
                    float lightRadius = lights[lightId].lightPosAndRadius.w;

                    vec3  closestPoint = clamp(lightPos, clusterMin, clusterMax);
                    float dist         = length(closestPoint - lightPos);

                    if (dist < lightRadius * 2.0)
                    {
                        lightIndices[clusterIndex * uint(MAX_LIGHT_COUNT) + tileLightCount] = uint(lightId);
                        tileLightCount++;
                    }
                }

                lightCounts[clusterIndex] = tileLightCount;
            }
        }
    }
}
